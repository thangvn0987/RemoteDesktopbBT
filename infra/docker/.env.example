# Common
LOG_LEVEL=info

# Web Portal
WEB_PORTAL_PORT=3000

# Signaling (HTTP+WS bridge)
WS_PORT=8080

# JWT signing secret used by signaling and the mint-token script
# Keep this in sync with services/signaling-service (env SIGNING_SECRET)
SIGNING_SECRET=change-me

# Helper inbound listener (for agent mode)
# Bind address inside the signaling container. Use 0.0.0.0 to accept from other machines.
HELPER_HOST=0.0.0.0
HELPER_PORT=5555
# Must match --token passed to remotebt_helper.exe on the controlled machine
HELPER_TOKEN=dev-secret

# Auth (placeholder)
AUTH_PORT=8081
AUTH_JWT_SECRET=change-me

# Session
SESSION_PORT=8082

# Audit
AUDIT_PORT=8083

# TURN (if enabled)
# TURN_REALM=remotedesktop.local
# TURN_USERNAME=demo
# TURN_PASSWORD=demo

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
SESSION_REDIS_URL=redis://redis:6379

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=remotedesktop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/remotedesktop
